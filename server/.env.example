# Copia este archivo a ".env" y completa los valores reales

# Gratis en https://aistudio.google.com (sección "API keys")
GEMINI_API_KEY=tu_api_key_aqui

# Azure AI Speech (https://portal.azure.com → crear recurso "Speech", tier
# gratuito Free F0) para voz natural. Si las dejas vacías, la voz cae de
# vuelta al TTS del navegador.
AZURE_SPEECH_KEY=tu_api_key_aqui
AZURE_SPEECH_REGION=tu_region_aqui

# Cadena de conexión de MongoDB Atlas (ver README para el paso a paso).
# Formato: mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=tu_connection_string_aqui

# Puerto en el que corre el servidor (opcional)
PORT=3000
